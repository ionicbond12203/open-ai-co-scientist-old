# Copy to .env (gitignored) and fill in. Keys come ONLY from the environment —
# never write one into code, config.yaml, fixtures, or logs (see AGENTS.md).

# Backend selection: openrouter (default) or lm_studio.
LLM_PROVIDER=openrouter

# Required for OpenRouter live runs. Offline `make test` needs no key.
OPENROUTER_API_KEY=

# LM Studio uses an OpenAI-compatible API. Its key is optional unless server
# authentication is enabled. LMSTUDIO_MODEL is optional; the UI can discover it.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=
LMSTUDIO_MODEL=
LMSTUDIO_REQUEST_TIMEOUT_SECONDS=300
LMSTUDIO_CONNECT_TIMEOUT_SECONDS=10
LMSTUDIO_ENABLE_FALLBACK=false

# Larger local models can require several minutes across a full multi-call cycle.
CO_SCIENTIST_CYCLE_TIMEOUT_SECONDS=1800

# Optional: only needed when driving the Codex CLI locally.
OPENAI_API_KEY=
