# DeepEval's local adapter requires a non-empty key even when LM Studio does
# not use authentication. Keep real credentials out of this file.
LOCAL_MODEL_API_KEY=lm-studio
LOCAL_MODEL_NAME=qwen/qwen3.8-27b
LOCAL_MODEL_BASE_URL=http://100.117.90.5:1234/v1

# A reasoning model can exceed DeepEval's default per-attempt budget.
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=2400
DEEPEVAL_PER_ATTEMPT_TIMEOUT_SECONDS_OVERRIDE=900

